# Local Python environment and caches
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.env

# Large/private data and model artifacts
/data/

# Generated experiment outputs stay local; keep only directory placeholders.
/outputs/*
!/outputs/.gitkeep
!/outputs/*/
/outputs/checkpoints/
/outputs/*/*
